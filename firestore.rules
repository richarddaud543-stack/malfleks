rules_version = '2';

// Soko — Firestore Security Rules.
//
// Firestore holds exactly one thing: a signed-in customer's saved order
// requests. The catalogue is Prisma's and stays Prisma's (docs/backend.md).
//
// Two properties this file exists to guarantee, both covered by tests in
// `src/security/firestore-rules.test.ts`:
//
//   1. A customer can read their own saved requests and nobody else's.
//   2. No client can write here at all. Every write goes through the Next.js
//      server via the Admin SDK, which bypasses these rules by design — that
//      is the intended path, not a hole. It is also why `customerId` can be
//      trusted: the server takes it from the verified session cookie, never
//      from the request body.
//
// Ownership is keyed by the *path*, not by a field in the document. A field
// can be spoofed on the write that creates it; a path segment compared against
// `request.auth.uid` cannot. It also makes `list` inherently scoped — a query
// can only ever address one customer's subcollection.
//
// Rules do not cascade into subcollections, and when several rules match a
// request access is granted if ANY of them passes (OR, not AND). Both are why
// there is exactly one `match` block per real path below.

service cloud.firestore {
  match /databases/{database}/documents {

    match /customers/{uid}/orderRequests/{requestId} {
      // `get` is a single document, `list` is a query. Both are owner-only.
      // Split out rather than written as `read` so it is obvious that queries
      // were considered and not inherited by accident.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if request.auth != null && request.auth.uid == uid;

      // Server-only, via the Admin SDK. A customer cannot forge a request,
      // edit one after the fact, or delete the record of one — an order
      // request is a thing they asked for, so it is evidence, not scratch
      // space.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Everything else has no matching rule and is therefore already denied.
    // Stated anyway: a deny you can read in review is worth more than a deny
    // you have to infer from the absence of something.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}

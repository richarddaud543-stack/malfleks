// Soko marketplace schema.
//
// This models the same four entities the site currently serves from the static
// arrays in `src/data/`. It deliberately mirrors those TypeScript interfaces
// field-for-field so the repository layer in `src/server/` can return the exact
// same shapes and the eventual cutover is an import-path change.
//
// SQLite is the dev provider so the project runs with no external service.
// Everything here is chosen to be Postgres-compatible: no scalar lists, no
// enums, no `Json` columns. See `docs/backend.md` for the Postgres switch.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here. The connection string lives in
// `prisma.config.ts` for Migrate, and reaches the client through a driver
// adapter (`src/server/db/client.ts`). Swapping providers therefore touches
// three known places, not the whole schema.
datasource db {
  provider = "sqlite"
}

model Brand {
  id   String @id
  slug String @unique

  name String

  // `BrandCategory` ("automotive" | "electronics" | "telecom") is a TS union.
  // SQLite has no enum type, so it is stored as text and narrowed back to the
  // union in the repository mapper. On Postgres this can become a real enum.
  category String

  logo        String
  accentColor String
  description String
  website     String?

  // Position in the source array. The static accessors return records in
  // declaration order, which is neither id- nor name-sorted; persisting the
  // index is the only way for the DB-backed functions to return an identical
  // ordering. Editors get an explicit ordering lever for free.
  sortOrder Int

  branches Branch[]
  products Product[]
  orders   Order[]

  @@index([category])
}

model Branch {
  id String @id

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String
  city        String
  region      String
  addressLine String

  // The TS type pins this to the literal "Tanzania"; the default keeps that
  // true for hand-inserted rows without blocking a future second market.
  country String @default("Tanzania")

  phone String?
  hours String

  // Drives the core routing rule: brand fleet if true, otherwise a local agent.
  deliveryOffered Boolean

  // Separates researched-real facts from illustrative placeholders. Load-bearing
  // for the UI's trust badges, so it is a first-class column, never inferred.
  verified Boolean

  // Approximate city-centre position for the locator map. Nullable and stored
  // as two columns rather than a point type: SQLite has no geometry, and the
  // precision here (a city, not a shopfront) does not warrant one. Both are set
  // together or neither is — see `mapBranch`.
  latitude  Float?
  longitude Float?

  sortOrder Int

  products Product[]
  orders   Order[]

  @@index([brandId])
  @@index([city])
}

model Product {
  id   String @id
  slug String @unique

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // brandId is denormalised from the branch, exactly as the static data has it.
  // Every product page and search facet filters by brand without needing the
  // branch, and the seed asserts the two agree.
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name     String
  category String

  // Whole Tanzanian shillings. Int, never Float or Decimal: TZS has no minor
  // unit in practice and float money is a rounding bug waiting to happen.
  priceTZS Int

  image       String
  description String
  inStock     Boolean

  sortOrder Int

  specs  ProductSpec[]
  orders Order[]

  @@index([branchId])
  @@index([brandId])
  @@index([category])
}

// `Product.specs` is a `Record<string, string>` in TypeScript. Prisma has no
// portable map type — `Json` is not supported on SQLite and a scalar list is
// Postgres-only — so the map is stored as rows. This survives a provider swap
// unchanged and makes specs queryable ("all 4x4 pickups") instead of opaque.
model ProductSpec {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  key   String
  value String

  // Spec order is meaningful on the product page (Engine before Seats), and
  // rows have no inherent order, so the declaration index is stored.
  position Int

  @@id([productId, key])
  @@index([productId, position])
}

model DeliveryAgent {
  id String @id

  name String
  city String

  phone    String
  verified Boolean

  // Days from pickup, `0` meaning same day; `etaMaxDays` is inclusive. This
  // replaced a single prose `etaEstimate` column so couriers can be ranked —
  // the display label is derived by `formatEta()` and never stored, which is
  // what stops the number and the words drifting apart.
  etaMinDays Int
  etaMaxDays Int

  sortOrder Int

  regionsServed AgentRegion[]
  orders        Order[]

  @@index([city])
}

// `DeliveryAgent.regionsServed` is a `string[]`. Prisma scalar lists only exist
// on Postgres/CockroachDB, so this is a join table — portable, and it gives the
// "does this agent serve city X" lookup a real index instead of a table scan.
model AgentRegion {
  agentId String
  agent   DeliveryAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  region   String
  position Int

  @@id([agentId, region])
  @@index([region])
}

// A customer's order request, signed in or anonymous — persisted the moment
// `OrderRequestForm` is submitted. See `docs/backend.md`'s third Decision
// block for why this is Prisma and not Firestore: it is squarely relational
// (joins to product/branch/brand/agent, needs admin/business querying), the
// same shape as the catalogue rather than the saved-order-requests exception.
//
// This resolves the two flags carried before an order existed to test them
// against — see the "Cascades" section and the pruning note in
// `docs/backend.md`, and the matching comment in `src/server/db/seed.ts`.
//
// `status` starts and stays "pending" until an admin queue exists to move it;
// text rather than an enum, matching `PartnerApplication`/`Partner` — SQLite
// has none, and an order is not a paid/confirmed transaction yet, which is
// exactly why this is *not* named after the customer-facing lib type
// (`OrderRequest` in src/lib/order.ts) despite mirroring its fields: that
// type is a receipt shown to the browser, this is the durable record.
model Order {
  id String @id @default(cuid())

  // Firebase uid, or null for a signed-out customer. Deliberately not a FK:
  // the identity lives in Firebase, not this database — same reasoning
  // `docs/backend.md` already gives for keeping saved order requests out of
  // Postgres. Present so a future "my orders" view can filter by it.
  customerId String?

  status String @default("pending")

  // ---- Loose catalogue references --------------------------------------
  //
  // Every one of these is nullable with `onDelete: SetNull`, never Cascade
  // and never a required FK. An order is evidence of what a customer was
  // shown at request time; a later catalogue edit — or a branch, product or
  // agent being removed outright — must never delete, rewrite or silently
  // reinterpret that evidence. Losing the *link* to a since-deleted branch
  // is an acceptable outcome; losing the *order* because a branch was
  // deleted is not. `Branch`, `Product` and `AgentRegion` keep cascading
  // from their own catalogue parents unchanged — a brand delete still
  // cannot orphan a product — but nothing cascades *into* `Order`. The
  // snapshot columns further down are what every page actually renders
  // from; these four are for admin joins and filters only.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // The chosen courier on an agent route. Always null on a brand route,
  // where no third party is involved at all.
  agentId       String?
  deliveryAgent DeliveryAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // ---- Snapshot: what the customer actually saw -------------------------
  // Mirrors `OrderRequest` (src/lib/order.ts) field for field. Never
  // recomputed from the current catalogue after the fact — see above.
  productName  String
  unitPriceTZS Int
  brandName    String
  brandSlug    String
  branchName   String
  branchCity   String
  branchPhone  String?

  routeKind        String
  routeCarrier     String
  routeAgentPhone  String?
  routeEtaEstimate String?

  customerFullName String
  customerPhone    String
  customerAddress  String

  quantity     Int
  lineTotalTZS Int

  // Read aloud to a branch on the phone (see `generateOrderReference` in
  // src/lib/order.ts), so it has to be unambiguous — and now that it
  // outlives a browser tab, it also has to be unique. The alphabet is 28
  // characters over 4 slots: 614,656 codes per brand+city pair, small enough
  // that a collision is reachable once orders accumulate for one branch
  // (~925 orders for 50% odds by the birthday bound). `@unique` catches it
  // at the database; `createOrder` (src/server/orders/create-order.ts)
  // regenerates and retries once rather than failing the request over it —
  // the reference is cosmetic, the order is not.
  reference String @unique

  // What the customer saw on screen when they submitted, distinct from
  // `createdAt` for the same reason Firestore's saved copy splits
  // `requestedAt`/`savedAt`: one is customer-supplied (and sanitized to a
  // 24h window around now, see `sanitizeRequestedAt`), the other is this
  // server's own clock.
  requestedAt DateTime
  createdAt   DateTime @default(now())

  // What an admin or branch view would query by: orders waiting on a
  // decision, a branch's own orders, newest first.
  @@index([status])
  @@index([branchId])
  @@index([createdAt])
  @@index([customerId])
}

// A brand branch or a courier asking to join Soko.
//
// The intake half of the partner pipeline in `docs/marketplace-model.md`:
// they apply here, an admin approves, and only then does a `Partner` exist and
// products can be submitted. Nothing reads this table yet — applications sit at
// `status = "pending"` until the admin queue is built, which is why the page
// says so rather than promising a reply.
//
// `Brand` is deliberately NOT a relation. A courier has no brand at all, and a
// branch may name a brand the catalogue has never heard of, so `brandId` is a
// loose reference the admin resolves at approval rather than a foreign key that
// would reject the applicant at submit time.
//
// `uid` and `email` come from the verified session, never the form. Same trust
// boundary as `buildOrderRequest` — the browser says what it wants, not who it
// is. On approval the uid becomes the `PartnerUser`, so the account the partner
// signs in with already exists and nobody has to create one.
model PartnerApplication {
  id String @id @default(cuid())

  // "brand" | "courier", and "pending" | "approved" | "rejected". Text rather
  // than enums, matching the rest of this schema: enums are not portable to
  // the SQLite dev provider.
  kind   String
  status String @default("pending")

  uid   String
  email String

  businessName String
  contactName  String
  // Stored +255-normalised by `normalizePhone()`, so two applicants who typed
  // 0754… and +255754… are the same number here.
  phone        String
  city         String

  /// Set when the applicant claims a brand already in the catalogue.
  brandId    String?
  /// Set instead when they name one that is not.
  brandOther String?
  /// Branch applications only. A courier serves a city, not an address.
  address    String?
  notes      String?

  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  /// The admin uid that decided. Null while pending.
  reviewedBy   String?
  /// Why it was rejected, so the decision is not folklore.
  decisionNote String?

  // The admin queue reads pending-first, oldest-first.
  @@index([status, createdAt])
  @@index([uid])
}

// An approved partner: a brand branch that may list products, or a courier
// that may be offered delivery jobs.
//
// Created only by an admin approving a `PartnerApplication`, never by signup.
//
// **Approval does not publish anything to customers.** `branchId` and `agentId`
// stay null until someone deliberately wires this partner into the catalogue,
// because a `Branch` row is customer-facing data and the `verified` flag rule
// says invented records must never claim to be real. Letting an approval create
// a live branch would put an unverified address on the locator map the moment a
// stranger filled in a form.
model Partner {
  id String @id @default(cuid())

  // "brand" | "courier", and "active" | "suspended". Text, not enums — see the
  // note on PartnerApplication.
  kind   String
  status String @default("active")

  displayName String
  contactName String
  phone       String
  city        String

  brandId String?
  address String?

  /// The catalogue rows this partner maps to, once wired up. Null until then.
  branchId String?
  agentId  String?

  /// The application this came from. Unique: approving twice is a bug, and the
  /// database is a better place to find that out than a code review.
  applicationId String   @unique
  approvedAt    DateTime @default(now())
  approvedBy    String

  users PartnerUser[]

  @@index([kind, status])
}

// The Firebase account that manages a partner.
//
// `uid` is the primary key, so one account belongs to at most one partner. That
// is a real constraint rather than an oversight: today a person running two
// branches would need two Google accounts. Revisit when someone actually does —
// it becomes a composite key and a partner switcher, not a schema rewrite.
model PartnerUser {
  uid String @id

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  role      String   @default("owner")
  createdAt DateTime @default(now())

  @@index([partnerId])
}

// MalFleks marketplace schema.
//
// This models the same four entities the site currently serves from the static
// arrays in `src/data/`. It deliberately mirrors those TypeScript interfaces
// field-for-field so the repository layer in `src/server/` can return the exact
// same shapes and the eventual cutover is an import-path change.
//
// Postgres everywhere: dev, CI and production all run the same engine, so the
// concurrency guarantees the integration tests prove are the ones that ship.
// See `docs/deploy.md` for why one build cannot serve two providers.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here. The connection string lives in
// `prisma.config.ts` for Migrate, and reaches the client through a driver
// adapter (`src/server/db/client.ts`). Swapping providers therefore touches
// three known places, not the whole schema.
datasource db {
  provider = "postgresql"
}

model Brand {
  id   String @id
  slug String @unique

  name String

  // `BrandCategory` ("automotive" | "electronics" | "telecom") is a TS union.
  // SQLite has no enum type, so it is stored as text and narrowed back to the
  // union in the repository mapper. On Postgres this can become a real enum.
  category String

  logo        String
  accentColor String
  description String
  website     String?

  // Position in the source array. The static accessors return records in
  // declaration order, which is neither id- nor name-sorted; persisting the
  // index is the only way for the DB-backed functions to return an identical
  // ordering. Editors get an explicit ordering lever for free.
  sortOrder Int

  branches Branch[]
  products Product[]
  orders   Order[]

  @@index([category])
}

model Branch {
  id String @id

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String
  city        String
  region      String
  // Nullable since 2026-08-31: present only when confirmed against a
  // primary source. See src/data/SOURCES.md.
  addressLine String?

  // The TS type pins this to the literal "Tanzania"; the default keeps that
  // true for hand-inserted rows without blocking a future second market.
  country String @default("Tanzania")

  phone String?
  hours String?

  // Drives the core routing rule: brand fleet if true, otherwise a local agent.
  deliveryOffered Boolean

  // Separates researched-real facts from illustrative placeholders. Load-bearing
  // for the UI's trust badges, so it is a first-class column, never inferred.
  verified Boolean

  // Approximate city-centre position for the locator map. Nullable and stored
  // as two columns rather than a point type: SQLite has no geometry, and the
  // precision here (a city, not a shopfront) does not warrant one. Both are set
  // together or neither is — see `mapBranch`.
  latitude  Float?
  longitude Float?

  sortOrder Int

  products Product[]
  orders   Order[]

  @@index([brandId])
  @@index([city])
}

model Product {
  id   String @id
  slug String @unique

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // brandId is denormalised from the branch, exactly as the static data has it.
  // Every product page and search facet filters by brand without needing the
  // branch, and the seed asserts the two agree.
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name     String
  category String

  // Whole Tanzanian shillings. Int, never Float or Decimal: TZS has no minor
  // unit in practice and float money is a rounding bug waiting to happen.
  priceTZS Int

  image       String
  description String
  inStock     Boolean

  // A real, partner-uploaded photo. Optional and additive to `image` — the
  // icon stays the required fallback (existing rows have no photo, and a
  // partner can still skip this), this only upgrades the card and detail
  // page to show it when present. Always a public URL under this project's
  // own `product-photos` Supabase Storage bucket; `submitProduct` checks that
  // shape before trusting a value from the client.
  photoUrl String?

  sortOrder Int

  specs  ProductSpec[]
  orders Order[]

  @@index([branchId])
  @@index([brandId])
  @@index([category])
}

// `Product.specs` is a `Record<string, string>` in TypeScript. Prisma has no
// portable map type — `Json` is not supported on SQLite and a scalar list is
// Postgres-only — so the map is stored as rows. This survives a provider swap
// unchanged and makes specs queryable ("all 4x4 pickups") instead of opaque.
model ProductSpec {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  key   String
  value String

  // Spec order is meaningful on the product page (Engine before Seats), and
  // rows have no inherent order, so the declaration index is stored.
  position Int

  @@id([productId, key])
  @@index([productId, position])
}

model DeliveryAgent {
  id String @id

  name String
  city String

  // Optional since 2026-08-31. Every seeded courier number was invented
  // (+255 68 000 0001..0005, a counting sequence) and two of them sat on
  // records flagged `verified`. Rather than publish a number nobody can
  // answer, the column now permits absence and the UI says so plainly —
  // the same choice `Branch.phone` already made.
  phone    String?
  verified Boolean

  // Days from pickup, `0` meaning same day; `etaMaxDays` is inclusive. This
  // replaced a single prose `etaEstimate` column so couriers can be ranked —
  // the display label is derived by `formatEta()` and never stored, which is
  // what stops the number and the words drifting apart.
  etaMinDays Int
  etaMaxDays Int

  sortOrder Int

  regionsServed AgentRegion[]
  orders        Order[]

  @@index([city])
}

// `DeliveryAgent.regionsServed` is a `string[]`. Prisma scalar lists only exist
// on Postgres/CockroachDB, so this is a join table — portable, and it gives the
// "does this agent serve city X" lookup a real index instead of a table scan.
model AgentRegion {
  agentId String
  agent   DeliveryAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  region   String
  position Int

  @@id([agentId, region])
  @@index([region])
}

// A customer's order request, signed in or anonymous — persisted the moment
// `OrderRequestForm` is submitted. See `docs/backend.md`'s third Decision
// block for why this is Prisma and not Firestore: it is squarely relational
// (joins to product/branch/brand/agent, needs admin/business querying), the
// same shape as the catalogue rather than the saved-order-requests exception.
//
// This resolves the two flags carried before an order existed to test them
// against — see the "Cascades" section and the pruning note in
// `docs/backend.md`, and the matching comment in `src/server/db/seed.ts`.
//
// `status` moves through a small, owner-defined workflow — "pending" |
// "confirmed" | "cancelled" | "fulfilled" — text rather than an enum,
// matching `PartnerApplication`/`Partner`: SQLite has none, and this is
// exactly why this is *not* named after the customer-facing lib type
// (`OrderRequest` in src/lib/order.ts) despite mirroring its fields: that
// type is a receipt shown to the browser, this is the durable record. The
// transition rules and the guarded write that moves this column live in
// `src/server/orders/status.ts`; only MalFleks admin moves it, via
// `/admin/orders`. "confirmed" still means no money has moved — see
// `docs/backend.md`.
model Order {
  id String @id @default(cuid())

  // Supabase user id (a UUID), or null for a signed-out customer.
  // Deliberately not a FK: the identity lives in Supabase's `auth.users`,
  // which is a schema this application's Prisma client does not model and
  // must not couple its migrations to. Present so a future "my orders" view
  // can filter by it.
  customerId String?

  status String @default("pending")

  // Mirrors `PartnerApplication.reviewedBy`/`reviewedAt`/`decisionNote`
  // exactly — the admin uid and time of the last status transition, and why,
  // for "cancelled" in particular. Null while still "pending".
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?

  // ---- Loose catalogue references --------------------------------------
  //
  // Every one of these is nullable with `onDelete: SetNull`, never Cascade
  // and never a required FK. An order is evidence of what a customer was
  // shown at request time; a later catalogue edit — or a branch, product or
  // agent being removed outright — must never delete, rewrite or silently
  // reinterpret that evidence. Losing the *link* to a since-deleted branch
  // is an acceptable outcome; losing the *order* because a branch was
  // deleted is not. `Branch`, `Product` and `AgentRegion` keep cascading
  // from their own catalogue parents unchanged — a brand delete still
  // cannot orphan a product — but nothing cascades *into* `Order`. The
  // snapshot columns further down are what every page actually renders
  // from; these four are for admin joins and filters only.
  productId     String?
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  brandId       String?
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // The chosen courier on an agent route. Always null on a brand route,
  // where no third party is involved at all.
  agentId       String?
  deliveryAgent DeliveryAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // ---- Snapshot: what the customer actually saw -------------------------
  // Mirrors `OrderRequest` (src/lib/order.ts) field for field. Never
  // recomputed from the current catalogue after the fact — see above.
  productName  String
  unitPriceTZS Int
  brandName    String
  brandSlug    String
  branchName   String
  branchCity   String
  branchPhone  String?

  routeKind        String
  routeCarrier     String
  routeAgentPhone  String?
  routeEtaEstimate String?

  customerFullName String
  customerPhone    String
  customerAddress  String

  quantity     Int
  lineTotalTZS Int

  // ---- Money: the quote snapshot, computed once at order time ----------
  // `src/lib/fees` (`quoteOrder`, via `quoteForOrder` in
  // `src/server/orders/quote-order.ts`) computes this once, here, and it is
  // never recomputed from a later fee table — the same discipline as every
  // snapshot column above. All six are null together when no honest quote
  // could be produced (an agent route into a city with no delivery fee set —
  // true for every city as of 2026-09-17, see `src/lib/fees/tables.ts`),
  // never a mix of some set and some null. MalFleks still takes no payment:
  // this is a record of what would be owed, not a charge.
  quoteGoodsRungTZS    Int?
  quoteDeliveryFeeTZS  Int?
  quoteDeliveryRungTZS Int?
  quoteDepositTZS      Int?
  quoteDoorPaymentTZS  Int?
  quoteOrderTotalTZS   Int?

  // Read aloud to a branch on the phone (see `generateOrderReference` in
  // src/lib/order.ts), so it has to be unambiguous — and now that it
  // outlives a browser tab, it also has to be unique. The alphabet is 28
  // characters over 4 slots: 614,656 codes per brand+city pair, small enough
  // that a collision is reachable once orders accumulate for one branch
  // (~925 orders for 50% odds by the birthday bound). `@unique` catches it
  // at the database; `createOrder` (src/server/orders/create-order.ts)
  // regenerates and retries once rather than failing the request over it —
  // the reference is cosmetic, the order is not.
  reference String @unique

  // What the customer saw on screen when they submitted, distinct from
  // `createdAt` for the same reason Firestore's saved copy splits
  // `requestedAt`/`savedAt`: one is customer-supplied (and sanitized to a
  // 24h window around now, see `sanitizeRequestedAt`), the other is this
  // server's own clock.
  requestedAt DateTime
  createdAt   DateTime @default(now())

  /// Append-only status history. See `OrderEvent`.
  events OrderEvent[]

  /// Where the delivery has been, as the partner fulfilling it reported it.
  /// See `DeliveryPing`.
  deliveryPings DeliveryPing[]

  // What an admin or branch view would query by: orders waiting on a
  // decision, a branch's own orders, newest first.
  @@index([status])
  @@index([branchId])
  @@index([createdAt])
  @@index([customerId])
}

// One status transition that actually happened, appended as it happens.
//
// `Order.decidedBy`/`decidedAt`/`decisionNote` record only the *last*
// transition, which is all a single-step review needed. A money system needs
// the whole sequence before it needs anything else — when was it confirmed,
// how long did it sit, who cancelled it after it was already confirmed — and
// none of that is recoverable from three columns that the next transition
// overwrites. `docs/marketplace-model.md` Stage 1 asks for exactly this.
//
// **Append-only by discipline, not by database constraint.** Nothing in this
// codebase updates or deletes an `OrderEvent`, and nothing should: an event is
// a record of something that happened, and a corrected history is not a
// history. SQLite cannot enforce that, so it is stated here and asserted by
// the tests in `status.integration.test.ts`.
//
// Cascade is deliberate and the opposite of `Order`'s own loose references: an
// event has no meaning without its order, where an order very much has meaning
// without the branch that has since been deleted.
//
// Not backfilled. Orders created before 2026-08-27 have no events, and
// inventing plausible ones would be fabricating a record — the same reasoning
// that keeps invented catalogue data from claiming `verified: true`.
model OrderEvent {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// The status the order was in. Null only for a synthetic "created" event.
  fromStatus String?
  /// The status it moved to.
  toStatus   String

  /// The admin uid that caused it. Null for a system or customer-driven event.
  actorUid String?
  /// Why — carries `cancelled`'s reason, mirroring `Order.decisionNote`.
  note     String?

  createdAt DateTime @default(now())

  // The history of one order, oldest first, is the only read this table has.
  @@index([orderId, createdAt])
}

// A courier or branch reporting where an in-progress delivery currently is.
//
// **Manual, not continuous GPS.** The owner's call on 2026-09-06: no courier
// mobile app exists, so background location reporting is not on the table.
// Instead the partner fulfilling the order taps "update my location" from
// `/partner/orders`, and the browser's own Geolocation API supplies the
// coordinates for that one moment — see `postDeliveryPing`
// (`src/server/orders/tracking.ts`). It is "live" in the sense that a
// customer's map reflects the courier's most recent tap, polled every
// ~20s, not that a phone streams a continuous trail.
//
// **Append-only**, the same discipline `OrderEvent` states on itself: nothing
// updates or deletes a `DeliveryPing`. The order's current position is always
// "the newest ping", derived by the reading query — never cached back onto
// `Order` itself, which would be a second place for the two to disagree.
//
// `note` is the courier's own word for where they are ("Picked up", "On the
// way", "Arrived") — deliberately distinct from `Order.status`, which only
// MalFleks admin moves through the guarded workflow in `status.ts`. A ping never
// changes an order's status; it is commentary, not a decision.
model DeliveryPing {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float

  note String?

  createdAt DateTime @default(now())

  // The only read this table has: one order's pings, newest first.
  @@index([orderId, createdAt])
}

// A brand branch or a courier asking to join MalFleks.
//
// The intake half of the partner pipeline in `docs/marketplace-model.md`:
// they apply here, an admin approves, and only then does a `Partner` exist and
// products can be submitted. Nothing reads this table yet — applications sit at
// `status = "pending"` until the admin queue is built, which is why the page
// says so rather than promising a reply.
//
// `Brand` is deliberately NOT a relation. A courier has no brand at all, and a
// branch may name a brand the catalogue has never heard of, so `brandId` is a
// loose reference the admin resolves at approval rather than a foreign key that
// would reject the applicant at submit time.
//
// `uid` and `email` come from the verified session, never the form. Same trust
// boundary as `buildOrderRequest` — the browser says what it wants, not who it
// is. On approval the uid becomes the `PartnerUser`, so the account the partner
// signs in with already exists and nobody has to create one.
model PartnerApplication {
  id String @id @default(cuid())

  // "brand" | "courier", and "pending" | "approved" | "rejected". Text rather
  // than enums, matching the rest of this schema: enums are not portable to
  // the SQLite dev provider.
  kind   String
  status String @default("pending")

  uid   String
  email String

  businessName String
  contactName  String
  // Stored +255-normalised by `normalizePhone()`, so two applicants who typed
  // 0754… and +255754… are the same number here.
  phone        String
  city         String

  /// Set when the applicant claims a brand already in the catalogue.
  brandId    String?
  /// Set instead when they name one that is not.
  brandOther String?
  /// Branch applications only. A courier serves a city, not an address.
  address    String?
  notes      String?

  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  /// The admin uid that decided. Null while pending.
  reviewedBy   String?
  /// Why it was rejected, so the decision is not folklore.
  decisionNote String?

  // The admin queue reads pending-first, oldest-first.
  @@index([status, createdAt])
  @@index([uid])
}

// An approved partner: a brand branch that may list products, or a courier
// that may be offered delivery jobs.
//
// Created only by an admin approving a `PartnerApplication`, never by signup.
//
// **Approval does not publish anything to customers.** `branchId` and `agentId`
// stay null until someone deliberately wires this partner into the catalogue,
// because a `Branch` row is customer-facing data and the `verified` flag rule
// says invented records must never claim to be real. Letting an approval create
// a live branch would put an unverified address on the locator map the moment a
// stranger filled in a form.
model Partner {
  id String @id @default(cuid())

  // "brand" | "courier", and "active" | "suspended". Text, not enums — see the
  // note on PartnerApplication.
  kind   String
  status String @default("active")

  displayName String
  contactName String
  phone       String
  city        String

  brandId String?
  address String?

  /// The catalogue rows this partner maps to, once wired up. Null until then.
  branchId String?
  agentId  String?

  /// The application this came from. Unique: approving twice is a bug, and the
  /// database is a better place to find that out than a code review.
  applicationId String   @unique
  approvedAt    DateTime @default(now())
  approvedBy    String

  users PartnerUser[]

  @@index([kind, status])
}

// The Supabase account that manages a partner.
//
// `uid` is the primary key, so one account belongs to at most one partner. That
// is a real constraint rather than an oversight: today a person running two
// branches would need two Google accounts. Revisit when someone actually does —
// it becomes a composite key and a partner switcher, not a schema rewrite.
model PartnerUser {
  uid String @id

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  role      String   @default("owner")
  createdAt DateTime @default(now())

  @@index([partnerId])
}

// A product a branch partner wants listed, waiting on admin review.
//
// This is the reversal debt #8 has been waiting for. Today `src/data` is the
// editorial source and `seedDatabase` mirrors it into the database; once
// branches submit products here and an admin publishes them, **the database
// becomes the source of truth** and `src/data` drops to seed and demo
// fixtures. `docs/marketplace-model.md` §3 spells that out.
//
// Nothing here is customer-visible. A submission is a proposal; publishing is
// what creates the live `Product` row, and only an admin does that.
//
// `branchId` is **derived from the submitting partner on the server**, never
// taken from the payload — the same trust boundary `buildOrderRequest` holds
// for prices. A branch says what it wants listed, not which branch it is.
model ProductSubmission {
  id String @id @default(cuid())

  /// The `Partner` that submitted it. Loose, like `Order`'s references: a
  /// submission is evidence of what was proposed, and it outlives the partner
  /// record being tidied up.
  partnerId String?
  /// Resolved from the partner at submit time, never from the form.
  branchId  String?
  brandId   String?

  // "pending" | "published" | "rejected". Text, not an enum — SQLite has none,
  // matching `PartnerApplication`, `Partner` and `Order`.
  status String @default("pending")

  // ---- The proposed product -------------------------------------------
  // Mirrors the customer-facing fields of `Product`. `slug`, `sortOrder` and
  // the id are assigned at publish time, not proposed by the submitter.
  name        String
  category    String
  priceTZS    Int
  image       String
  description String
  inStock     Boolean @default(true)

  // Same field, same rules as `Product.photoUrl` — carried over verbatim by
  // `publishSubmission` when the submission is approved.
  photoUrl String?

  specs ProductSubmissionSpec[]

  // ---- Review ----------------------------------------------------------
  // Mirrors `PartnerApplication.reviewedBy`/`reviewedAt`/`decisionNote` field
  // for field, because the review flow is the same shape and a reader should
  // not have to learn two vocabularies for one idea.
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  /// The admin uid that decided. Null while pending.
  reviewedBy   String?
  /// Why it was rejected, so the decision is not folklore.
  decisionNote String?

  /// The live `Product` this became. Unique: publishing twice is a bug, and
  /// the database is a better place to find that out than a code review —
  /// exactly the reasoning behind `Partner.applicationId`.
  publishedProductId String? @unique

  // The admin queue reads pending-first, oldest-first.
  @@index([status, createdAt])
  @@index([partnerId])
}

// `Product.specs` is a `Record<string, string>`; `ProductSpec` stores it as
// rows for portability. A submission's proposed specs need the same treatment
// and the same reasoning — see the note on `ProductSpec`.
model ProductSubmissionSpec {
  submissionId String
  submission   ProductSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  key   String
  value String

  position Int

  @@id([submissionId, key])
  @@index([submissionId, position])
}

// A fixed-window rate-limit hit: one row per accepted call, per caller, per
// action. See `src/server/rate-limit.ts` for the counting logic — this table
// is deliberately dumb, with no state beyond "this key was hit at this time".
//
// Postgres, not Redis: MalFleks has no Redis/Upstash account, every write
// this guards already pays for a Postgres round trip, and the traffic these
// endpoints see (one human, one form) is nowhere near what would need
// something faster. Rows are cheap to write and cheap to clean up — see the
// opportunistic delete in `checkRateLimit` — so this never needs a cron job
// of its own.
model RateLimitHit {
  id String @id @default(cuid())

  /// `<action>:<caller identity>` — see `checkRateLimit`. Never an IP alone:
  /// Vercel's functions don't reliably expose one, and IPs are shared behind
  /// carrier NAT in Tanzania, which would rate-limit strangers together.
  key String

  createdAt DateTime @default(now())

  // Every read filters by key; most also filter by a recency cutoff.
  @@index([key, createdAt])
}

// A server-side error, captured where a Server Action's outer `catch` would
// otherwise have swallowed it and told the caller only "unavailable" or
// "failed" — see `src/server/error-log.ts`.
//
// Postgres, not a real error-monitoring account: Sentry (or similar) needs a
// new paid-account signup this session cannot do on the owner's behalf, so
// this is the fallback that ships without one. It answers the one question
// that actually matters day to day — "did anything break, and what" — from
// `/admin`, and can be swapped for a real provider later without touching any
// call site, since every one of them calls the same `logServerError`.
model ServerErrorLog {
  id String @id @default(cuid())

  /// A short, stable name for where this came from, e.g. `"submit-order"` —
  /// the same vocabulary as `RateLimitHit.key`'s action segment, so the two
  /// logs read as one system rather than two.
  context String

  /// `error.message`, or `String(error)` for a thrown non-Error. Truncated by
  /// the logger before this is ever written — see its own doc comment.
  message String

  /// `error.stack`, when the thrown value had one. Absent for a thrown
  /// non-Error and for anything the truncation dropped.
  stack String?

  /// The signed-in caller's uid, when the action had a session — never a name
  /// or email, and never populated for a signed-out caller.
  uid String?

  createdAt DateTime @default(now())

  // The only read this table has: newest first, optionally by context.
  @@index([createdAt])
  @@index([context, createdAt])
}

// A signed-in customer's own copy of an order request.
//
// ## Why this is a separate table from `Order`
//
// They look like duplicates and they are not. `Order` is MalFleks's record —
// written for every request, signed in or not, and it must survive: it is what
// the admin queue works from and what the status workflow transitions. This is
// the *customer's* copy, and its defining property is that the customer can
// delete it. Merging them would mean either a customer can destroy MalFleks's
// operational record, or the "delete my saved request" button quietly does not
// delete. Both are worse than one extra table.
//
// ## Why the request is a Json column
//
// It arrives as `OrderRequest` (src/lib/order.ts) — a nested snapshot of the
// product, brand, branch, route and customer details exactly as shown at
// request time. `Order` already flattens that same shape into columns because
// admins filter and join on it. Nothing filters on this one; it is fetched
// whole, by owner, and rendered. Flattening it a second time would create a
// second thing to keep in step with `OrderRequest` for no query that needs it.
//
// ## Ownership
//
// `customerId` is the Supabase user id, taken from the verified session and
// never from a payload. Under Firestore, ownership was a *path segment*
// checked by a rules file, which is why the old code had to validate that an
// incoming id was not secretly a path. Here it is a `WHERE` clause: an id
// belonging to another customer matches zero rows and reads as not-found. The
// injection surface is gone rather than guarded.
model SavedOrderRequest {
  id String @id @default(cuid())

  /// Supabase user id. Not a FK, for the reason given on `Order.customerId`.
  customerId String

  /// Denormalised out of `payload` so a customer's list can be found by the
  /// reference they were shown, without reading every row's JSON.
  reference String

  /// When the customer submitted, as they saw it.
  requestedAt DateTime
  /// When it actually landed here. The server's clock, not the browser's.
  savedAt     DateTime @default(now())

  /// The whole `OrderRequest`. See the note above.
  payload Json

  // The only read path: one customer's requests, newest first.
  @@index([customerId, requestedAt])
  @@index([customerId, reference])
}

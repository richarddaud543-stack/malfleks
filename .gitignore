# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# agent worktrees (Claude Code creates these inside the repo)
/.claude/
# ...but the team's skill files are the point of the exercise: they are how each
# engineer's expertise compounds across sessions instead of being re-derived
# cold every time. They belong in version control.
!/.claude/skills/
!/.claude/skills/**

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database (local SQLite file + its WAL/journal sidecars; never commit a binary DB)
*.db
*.db-journal
*.db-shm
*.db-wal

# Prisma Client is generated into node_modules/@prisma/client by `prisma generate`,
# which /node_modules above already covers. Keep any custom generator `output`
# path ignored here too if one is ever configured.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache
/.playwright-mcp

# firebase emulator + CLI scratch (the emulator writes these next to firebase.json)
firebase-debug.log
firestore-debug.log
ui-debug.log
/.firebase

# next.js
/.next/
/out/

# agent worktrees (Claude Code creates these inside the repo)
#
# Note the trailing `*`: git cannot re-include a path inside an ignored
# *directory*, so ignoring `/.claude/` outright would make the negation below a
# no-op. Ignoring the contents instead leaves the directory itself visible.
/.claude/*
# The team's skill files are the point of the exercise — how each engineer's
# expertise compounds across sessions instead of being re-derived cold every
# time. They belong in version control, and so do the agent definitions that
# give each engineer its standing identity.
!/.claude/skills/
!/.claude/agents/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database (local SQLite file + its WAL/journal sidecars; never commit a binary DB)
*.db
*.db-journal
*.db-shm
*.db-wal

# Prisma Client is generated into node_modules/@prisma/client by `prisma generate`,
# which /node_modules above already covers. Keep any custom generator `output`
# path ignored here too if one is ever configured.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
